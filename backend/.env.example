NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/vitacoin
JWT_SECRET=change-me-in-production

# Frontend origin(s) allowed for CORS + Socket.IO (comma-separated, no trailing slashes).
# Always include http://localhost:3000 in code for local dev; add your Vercel URL for production.
CORS_ORIGIN=https://your-app.vercel.app

# Optional: httpOnly JWT cookie name (default: vitacoin_token)
# JWT_COOKIE_NAME=vitacoin_token

# Resend email settings for forgot-password OTP emails
# Create an API key at https://resend.com and add it to your backend host.
RESEND_API_KEY=re_your_api_key

# For quick testing, Resend allows the default sender below.
# For real production use, verify your own domain in Resend and replace this
# with something like: Vitacoin <noreply@yourdomain.com>
EMAIL_FROM=Vitacoin <onboarding@resend.dev>

# Optional branding / reset flow timing
# APP_NAME=Vitacoin
# PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
# PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60

# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# If true (default), insert default games when the games collection is empty (first Render deploy).
# Set to false to skip: AUTO_SEED_GAMES_IF_EMPTY=false

# Admin bootstrap for production hosts like Render.
# On startup, the backend will create or repair this admin account after MongoDB connects.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-admin-password
# Optional:
# ADMIN_USERNAME=admin
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User
# AUTO_BOOTSTRAP_ADMIN=true
