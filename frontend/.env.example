# Copy to .env.local for local dev (CRA loads .env, .env.local, etc.)
# Vercel: set these in Project Settings → Environment Variables

# Required in production: your Render (or other) API origin, no trailing slash
REACT_APP_API_URL=https://your-api.onrender.com

# Optional: Socket.IO server (defaults to REACT_APP_API_URL)
# REACT_APP_SOCKET_URL=https://your-api.onrender.com

# Optional: show demo coupon top-up in non-dev builds
# REACT_APP_ENABLE_COUPON_DEMO=false
